# ElderWise — local / Preview env template
# Copy to .env.local (gitignored).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Scripts + server-side doctor share route (Architecture §7.3) — never NEXT_PUBLIC_*, never client
SUPABASE_SERVICE_ROLE_KEY=

# Optional — A3.5 rate limits (share reveal per IP, PDF per user). Fail-open if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
