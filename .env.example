# ElderWise — local / Preview env template
# Copy to .env.local (gitignored). Never set DEV_AUTOLOGIN=true in Production.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only auto-login (Phases A2.2; removed in A3.3). Fail closed when absent.
DEV_AUTOLOGIN=false
DEV_SEED_EMAIL=
DEV_SEED_PASSWORD=

# Scripts only (create-seed-user) — never NEXT_PUBLIC_*, never client
SUPABASE_SERVICE_ROLE_KEY=
