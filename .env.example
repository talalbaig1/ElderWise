# ElderWise — local / Preview env template
# Copy to .env.local (gitignored).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Scripts + server-side doctor share route (Architecture §7.3) — never NEXT_PUBLIC_*, never client
SUPABASE_SERVICE_ROLE_KEY=

# Optional — A3.5 rate limits (share reveal per IP, PDF per user). Fail-open if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# A2.7 — n8n SOS-resolution webhook (Architecture §8 WF-4, §12.4)
# Server-side only. Never NEXT_PUBLIC_*, never a client component.
#
# Contract (ElderWise WF-4a - SOS Resolution Receiver, n8n jeNrf7b7ne3JX2Xu):
#   POST <url>
#   Header: X-ElderWise-Signature: <secret>
#   Body:   { "sos_event_id": "<uuid>" }
#   200 -> resolution confirmed in DB
#   409 -> DB still shows status='open' (real bug: the write did not commit)
#   404 -> unknown sos_event_id
#   403 -> bad or missing secret
#
# Fire from the route handler AFTER the Supabase write commits.
# On non-2xx: log Sentry P1 and do NOT fail the user's request — WF-4's
# pre-nudge sos_events.status re-check is the actual safety net (Architecture §8).
# The receiver VERIFIES ONLY and never writes; Next.js owns the resolution write.
N8N_SOS_RESOLVED_WEBHOOK_URL=https://vmi3189816.contaboserver.net/webhook/elderwise-sos-resolved
N8N_SOS_RESOLVED_WEBHOOK_SECRET=

# Waitlist — n8n confirmation dispatch (email + WhatsApp). Server-side only.
N8N_WAITLIST_WEBHOOK_URL=
N8N_WAITLIST_WEBHOOK_SECRET=

# Sentry — Next.js error tracking (Architecture §11.1). Server-side only.
# Deliberately NOT NEXT_PUBLIC_*: the browser SDK is not installed (ruled 4 Aug 2026).
# SENTRY_AUTH_TOKEN is build-time only and must never be committed.
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Verification console — server-only gate (default off). Not NEXT_PUBLIC_*.
VERIFY_CONSOLE_ENABLED=false
