        "options": {
          "connectionTimeout": 10,
          "queryReplacement": "={{ [ JSON.stringify($('Find Orphan Objects').first().json.prefixes), 'WF-11 swept ' + $('Find Orphan Objects').first().json.orphan_count + ' orphan object(s). Elder prefixes: ' + $('Find Orphan Objects').first().json.elder_prefixes ] }}"
