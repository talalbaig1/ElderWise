    {
      "credentials": {
        "postgres": {
          "id": "WH9oLDfKfOX6KW5F",
          "name": "ElderWise Supabase (Postgres)"
        }
      },
      "id": "385ff046-2fbf-4281-853e-146c4f9d52e5",
      "name": "Find Orphan Objects",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "connectionTimeout": 30
        },
        "query": "WITH orphans AS (SELECT o.name, o.created_at FROM storage.objects o WHERE o.bucket_id = 'voice-notes' AND o.created_at < now() - interval '5 minutes' AND NOT EXISTS (SELECT 1 FROM elders e WHERE e.id::text = split_part(o.name, '/', 1)) ORDER BY o.created_at LIMIT 100) SELECT count(*)::int AS orphan_count, coalesce(json_agg(orphans.name), '[]'::json) AS prefixes, coalesce(string_agg(DISTINCT split_part(orphans.name, '/', 1), ', '), '') AS elder_prefixes, coalesce(to_char(min(orphans.created_at) AT TIME ZONE 'Asia/Riyadh', 'YYYY-MM-DD HH24:MI'), 'n/a') AS oldest_riyadh FROM orphans"
      },
      "position": [
        224,
        96
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
      "id": "113b37fa-1e5b-4972-a5d4-5ed6b681140f",
      "name": "Any Orphans?",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.orphan_count > 0 }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": ""
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          }
        },
        "options": {}
      },
      "position": [
