  "meta": {
    "aiBuilderAssisted": true,
    "builderVariant": "mcp"
  },
  "name": "ElderWise WF-11 - Orphan Storage Sweep",
  "nodes": [
    {
      "id": "4d889d1f-764d-4dfd-9977-29133244ad44",
      "name": "Every 15 Minutes",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "position": [
        0,
