      "id": "5cfb855d-7f53-4b5e-a4bf-d74102e9f27e",
      "name": "Resolve Elder",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "connectionTimeout": 10,
          "queryReplacement": "={{ $json.sender_e164 }}"
        },
        "query": "SELECT $1::text AS sender, (e.id IS NOT NULL) AS found, e.id AS elder_id, COALESCE(e.first_name, '') AS elder_first_name, (e.consent_requested_at IS NOT NULL) AS consent_requested, (e.consent_confirmed_at IS NOT NULL) AS consent_confirmed, (e.consent_declined_at IS NOT NULL) AS consent_declined FROM (SELECT 1) AS probe LEFT JOIN elders e ON e.whatsapp_number = $1::text AND e.active = true",
        "resource": "database"
      },
      "position": [
        672,
        96
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
      "id": "fb9a6d6a-e77a-480c-897b-e58e18d402d4",
      "name": "Decide Route",
      "parameters": {
        "jsCode": "const db = $input.first().json;\nconst parsed = $('Parse Inbound Message').first().json;\n\n// Exact normalised forms of the approved button labels (Templates.md 3.2).\nconst CONSENT_YES = 'yes thats fine';\nconst CONSENT_NO = 'no thank you';\nconst MED_BUTTONS = ['yes all', 'some of them', 'not yet'];\n\n// Food and health both use bare Yes / No, which cannot be told apart by text.\n// Attribution is by context_wamid against checkins.wa_message_id in WF-3d.\nconst FOOD_HEALTH_BUTTONS = ['yes', 'no'];\n\n// Whole-message exact match only (Talal, 3 Aug 2026). A contains-match would\n// fire a three-person emergency on \"can you help me with my tablets?\".\nconst SOS_TRIGGERS = ['sos', 'help'];\n\n// All four approved SOS resolution labels, normalised (Templates.md 3.2).\nconst SOS_RESOLVERS = ['i am responding', 'im responding', 'im on my way', 'acknowledge'];\n\nlet route = 'unhandled';\n\n// SOS trigger is checked FIRST and short-circuits everything else (P2).\n// Fires regardless of consent state, including a declined elder: she is the\n// sender, and the alerts go to her care circle, not to her (S-4).\nif (db.found === true && SOS_TRIGGERS.indexOf(parsed.text_norm) !== -1) {\n  route = 'sos_trigger';\n}\n\n// SOS resolution comes from the care circle, who are NOT in elders, so this\n// sits outside the db.found block. Attribution is by context_wamid in WF-4b,\n// never by sender number - one person may hold several roles (S-6).\nif (route === 'unhandled' && SOS_RESOLVERS.indexOf(parsed.button_norm) !== -1 && parsed.context_wamid) {\n  route = 'sos_resolution';\n}\n\nif (route === 'unhandled' && db.found === true) {\n  // Consent is only in play before she has confirmed or declined.\n  if (db.consent_confirmed === false && db.consent_declined === false) {\n    if (parsed.button_norm === CONSENT_YES) { route = 'consent_yes'; }\n    else if (parsed.button_norm === CONSENT_NO) { route = 'consent_no'; }\n  }\n\n  // Routine replies only count for a consented elder. A declined or pending\n  // elder should never be in a check-in cycle at all.\n  if (route === 'unhandled' && db.consent_confirmed === true && db.consent_declined === false) {\n    if (MED_BUTTONS.indexOf(parsed.button_norm) !== -1) {\n      route = 'med_response';\n    } else if (FOOD_HEALTH_BUTTONS.indexOf(parsed.button_norm) !== -1 && parsed.context_wamid) {\n      // A \"No\" here is a recorded negative response, NOT a missed check-in\n      // (Templates.md 3.2). WF-3d records it as responded.\n      route = 'food_health_response';\n    } else if (parsed.message_type === 'audio' && parsed.media_id) {\n      // Voice note on an open check-in. WF-5 resolves the check-in BEFORE it\n      // downloads any media, so an elder with no open check-in never has audio\n      // stored. This gate is defence in depth, not the primary safeguard.\n      route = 'voice_note';\n    }\n  }\n}\n\nreturn [{ json: Object.assign({}, db, parsed, { route: route }) }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
