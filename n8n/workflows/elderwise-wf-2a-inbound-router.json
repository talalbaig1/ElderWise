      "id": "88a2155f-5fa3-46e8-8d52-d2f6989d42d7",
      "name": "Resolve Elder",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "connectionTimeout": 10,
          "queryReplacement": "={{ $json.sender_e164 }}"
        },
        "query": "SELECT $1::text AS sender, (e.id IS NOT NULL) AS found, e.id AS elder_id, COALESCE(e.first_name, '') AS elder_first_name, (e.consent_requested_at IS NOT NULL) AS consent_requested, (e.consent_confirmed_at IS NOT NULL) AS consent_confirmed, (e.consent_declined_at IS NOT NULL) AS consent_declined FROM (SELECT 1) AS probe LEFT JOIN elders e ON e.whatsapp_number = $1::text AND e.active = true",
        "resource": "database"
      },
      "position": [
        672,
        96
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
      "id": "dee2f621-7e3c-4429-a4f9-7f3e64af33b4",
      "name": "Decide Route",
      "parameters": {
        "jsCode": "const db = $input.first().json;\nconst parsed = $('Parse Inbound Message').first().json;\n\n// Exact normalised forms of the approved button labels (Templates.md 3.2).\nconst CONSENT_YES = 'yes thats fine';\nconst CONSENT_NO = 'no thank you';\nconst MED_BUTTONS = ['yes all', 'some of them', 'not yet'];\n\nlet route = 'unhandled';\n\nif (db.found === true) {\n  // Consent is only in play before she has confirmed or declined.\n  if (db.consent_confirmed === false && db.consent_declined === false) {\n    if (parsed.button_norm === CONSENT_YES) { route = 'consent_yes'; }\n    else if (parsed.button_norm === CONSENT_NO) { route = 'consent_no'; }\n  }\n\n  // Medication replies only count for a consented elder. A declined or\n  // pending elder should never be in a check-in cycle at all.\n  if (route === 'unhandled' && db.consent_confirmed === true && db.consent_declined === false) {\n    if (MED_BUTTONS.indexOf(parsed.button_norm) !== -1) { route = 'med_response'; }\n  }\n}\n\nreturn [{ json: Object.assign({}, db, parsed, { route: route }) }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
      "position": [
        896,
        96
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
