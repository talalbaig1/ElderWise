    {
      "id": "dadfb5fa-b792-48f5-8804-3c4e70ca1b80",
      "name": "Parse Inbound Message",
      "parameters": {
        "jsCode": "// Payload may arrive as the WhatsApp Trigger output, the raw Meta envelope,\n// or wrapped under .body. Try every plausible shape rather than assuming one.\nconst first = $input.first()?.json ?? {};\nconst candidates = [first, first.body, first.body?.entry?.[0]?.changes?.[0]?.value, first.entry?.[0]?.changes?.[0]?.value].filter(Boolean);\n\nlet value = null;\nfor (const c of candidates) {\n  if (Array.isArray(c?.messages) && c.messages.length > 0) { value = c; break; }\n}\n\n// Delivery-status callbacks (sent / delivered / read) carry a `statuses` array\n// and no `messages`. Normal traffic, not errors. Report and stop.\nif (!value) {\n  const isStatus = candidates.some(function (c) { return Array.isArray(c?.statuses); });\n  return [{ json: { parsed: false, reason: isStatus ? 'delivery status callback' : 'no messages array found', sender_e164: '', button_norm: '', top_level_keys: Object.keys(first).toString() } }];\n}\n\nconst msg = value.messages[0];\nconst waId = msg.from ?? value.contacts?.[0]?.wa_id ?? '';\n\n// Numbers are stored with a leading +; Meta returns them without one.\nconst senderE164 = waId ? (String(waId).charAt(0) === '+' ? String(waId) : '+' + String(waId)) : '';\n\n// Quick-reply text arrives in two different shapes.\nconst rawButton = msg.button?.text ?? msg.interactive?.button_reply?.title ?? '';\n\n// Never compare raw strings (Templates.md 3.2).\nconst buttonNorm = String(rawButton).toLowerCase().replace(/[\\u0027\\u2018\\u2019\\u0060]/g, '').replace(/[^a-z0-9]+/g, ' ').trim();\n\nconst ok = senderE164.length > 1;\n\nreturn [{ json: { parsed: ok, reason: ok ? 'message' : 'message with no sender', sender_e164: senderE164, wa_id_raw: String(waId), message_type: msg.type ?? 'unknown', wa_message_id: msg.id ?? '', button_text_raw: String(rawButton), button_norm: buttonNorm, text_body: msg.text?.body ?? '' } }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
      "position": [
        224,
        192
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
