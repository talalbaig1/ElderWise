        "query": "SELECT dc.ct_notification, cp.whatsapp_number AS ct_whatsapp, cp.full_name AS ct_name, e.first_name AS elder_name, c.domain, c.response_value FROM checkins c JOIN elders e ON c.elder_id = e.id JOIN care_partners cp ON e.care_partner_id = cp.id JOIN domain_configs dc ON dc.elder_id = e.id AND dc.domain = c.domain WHERE c.id = '{{ $json.checkin_id }}';",
        "options": {}
