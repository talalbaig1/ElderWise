    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT c.id AS checkin_id, c.elder_id, c.domain, c.sent_at, e.first_name AS elder_name, cp.id AS care_partner_id, cp.whatsapp_number AS ct_whatsapp, cp.full_name AS ct_name, COALESCE(m.escalation_minutes, fr.escalation_minutes, hr.escalation_minutes, 30) AS escalation_minutes FROM checkins c JOIN elders e ON c.elder_id = e.id JOIN care_partners cp ON e.care_partner_id = cp.id LEFT JOIN medications m ON c.domain = 'medication' AND m.elder_id = e.id LEFT JOIN food_routines fr ON c.domain = 'food' AND fr.elder_id = e.id LEFT JOIN health_routines hr ON c.domain = 'health' AND hr.elder_id = e.id WHERE c.status = 'sent' AND c.sent_at < NOW() - (COALESCE(m.escalation_minutes, fr.escalation_minutes, hr.escalation_minutes, 30) || ' minutes')::interval LIMIT 50;",
        "options": {}
      },
      "id": "416a05c1-1348-4723-8e4d-faf654cd1af6",
