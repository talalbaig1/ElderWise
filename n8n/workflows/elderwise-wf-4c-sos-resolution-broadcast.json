      "id": "65601ae7-e2de-409d-82c0-86461603ddc0",
      "name": "Load Broadcast Recipients",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "connectionTimeout": 10,
          "queryReplacement": "={{ $json.sos_event_id }}"
        },
        "query": "WITH ev AS (SELECT s.id, s.elder_id, s.resolved_at, s.resolved_by_role, s.resolved_by_id FROM sos_events s WHERE s.id = $1::uuid AND s.status = 'resolved'), resolver AS (SELECT COALESCE(rcp.first_name, rlc.first_name, rd.first_name, 'Someone') AS resolver_first_name FROM ev LEFT JOIN care_partners rcp ON ev.resolved_by_role = 'care_partner' AND rcp.id = ev.resolved_by_id LEFT JOIN local_caregivers rlc ON ev.resolved_by_role = 'local_caregiver' AND rlc.id = ev.resolved_by_id LEFT JOIN doctors rd ON ev.resolved_by_role = 'doctor' AND rd.id = ev.resolved_by_id), recips AS (SELECT DISTINCT n.recipient_role, n.recipient_id FROM sos_notifications n JOIN ev ON n.sos_event_id = ev.id WHERE n.status = 'sent') SELECT ev.id AS sos_event_id, e.first_name AS elder_first_name, r.recipient_role::text AS recipient_role, r.recipient_id, CASE r.recipient_role WHEN 'care_partner' THEN cp.whatsapp_number WHEN 'local_caregiver' THEN lc.whatsapp_number WHEN 'doctor' THEN d.whatsapp_number END AS recipient_number, resolver.resolver_first_name, to_char(ev.resolved_at AT TIME ZONE (CASE r.recipient_role WHEN 'care_partner' THEN cp.timezone ELSE e.timezone END), 'FMHH12:MI AM') AS resolved_label FROM recips r CROSS JOIN ev CROSS JOIN resolver JOIN elders e ON e.id = ev.elder_id LEFT JOIN care_partners cp ON cp.id = r.recipient_id AND r.recipient_role = 'care_partner' LEFT JOIN local_caregivers lc ON lc.id = r.recipient_id AND r.recipient_role = 'local_caregiver' LEFT JOIN doctors d ON d.id = r.recipient_id AND r.recipient_role = 'doctor'",
        "resource": "database"
      },
      "position": [
        448,
        96
      ],
      "retryOnFail": true,
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
