      "id": "9cf5b92f-7fbb-4589-b5f5-712e4350726f",
      "name": "Load Notification Context",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "connectionTimeout": 10,
          "queryReplacement": "={{ $json.checkin_id }}"
        },
        "query": "SELECT c.id AS checkin_id, c.domain::text AS domain, c.status::text AS checkin_status, c.response_value, e.id AS elder_id, e.first_name AS elder_first_name, cp.id AS care_partner_id, cp.whatsapp_number AS cp_whatsapp, COALESCE(MIN(m.notify_care_partner::text), 'every_time') AS notify_mode, to_char(c.scheduled_for AT TIME ZONE cp.timezone, 'FMHH12:MI am') AS scheduled_label_cp, to_char(COALESCE(c.responded_at, now()) AT TIME ZONE cp.timezone, 'FMHH12:MI AM, FMDD Mon') AS responded_label_cp, CASE WHEN EXTRACT(hour FROM (c.scheduled_for AT TIME ZONE e.timezone)) < 12 THEN 'Morning' WHEN EXTRACT(hour FROM (c.scheduled_for AT TIME ZONE e.timezone)) < 17 THEN 'Afternoon' WHEN EXTRACT(hour FROM (c.scheduled_for AT TIME ZONE e.timezone)) < 21 THEN 'Evening' ELSE 'Night' END AS period_label, CASE c.response_value WHEN 'yes_all' THEN 'Taken' WHEN 'not_yet' THEN 'Not taken yet' WHEN 'some_of_them' THEN 'Partially taken' ELSE 'Recorded' END AS status_label FROM checkins c JOIN elders e ON e.id = c.elder_id JOIN care_partners cp ON cp.id = e.care_partner_id LEFT JOIN medications m ON m.elder_id = e.id AND m.enabled AND m.active AND to_char(c.scheduled_for AT TIME ZONE e.timezone, 'HH24:MI') = ANY(m.times) WHERE c.id = $1::uuid GROUP BY c.id, c.domain, c.status, c.response_value, c.scheduled_for, c.responded_at, e.id, e.first_name, e.timezone, cp.id, cp.whatsapp_number, cp.timezone",
        "resource": "database"
      },
      "position": [
        448,
        192
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
      "id": "54f3d670-27b6-4d60-bef0-faeb6734e62d",
      "name": "Should We Notify?",
      "parameters": {
        "jsCode": "const db = $input.first().json;\nconst called = $('Called With checkin_id').first().json;\n\nconst type = String(called.notification_type ?? 'interaction');\nconst mode = String(db.notify_mode ?? 'every_time');\n\n// Architecture 8 / WF-6: the OWNING ROUTINE's notify_care_partner is\n// authoritative. domain_configs.ct_notification is derived/deprecated (A-9).\n// not_required = total silence: no confirmation and no missed push. The miss\n// is still recorded in the DB and visible on the dashboard.\nlet shouldSend = false;\nif (mode !== 'not_required') {\n  if (type === 'missed') {\n    shouldSend = true;\n  } else if (mode === 'every_time') {\n    shouldSend = true;\n  } else if (mode === 'only_missed' && db.response_value === 'some_of_them') {\n    // Ruled by Talal 3 Aug 2026: a partial dose is closer to a miss than to a\n    // clean yes, so only_missed still notifies. Deliberate deviation from the\n    // literal reading of only_missed - do not 'fix' it back.\n    shouldSend = true;\n  }\n}\n\nconst domainLabel = db.domain === 'medication' ? 'Medication' : String(db.domain);\n\nreturn [{ json: Object.assign({}, db, { notification_type: type, should_send: shouldSend, is_missed: type === 'missed', routine_label_missed: db.period_label + ' ' + domainLabel, routine_label_interaction: domainLabel + ' (' + db.period_label + ')' }) }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
      "position": [
        672,
        192
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
