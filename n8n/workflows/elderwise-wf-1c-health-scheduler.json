    {
      "credentials": {
        "postgres": {
          "id": "WH9oLDfKfOX6KW5F",
          "name": "ElderWise Supabase (Postgres)"
        }
      },
      "id": "e6f59c6a-17a5-4cd8-969f-cbf750a20274",
      "name": "Materialise Due Health Check-ins",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "connectionTimeout": 10
        },
        "query": "WITH ins AS (INSERT INTO checkins (elder_id, domain, health_routine_id, scheduled_for, status) SELECT e.id, 'health'::care_domain, h.id, (((now() AT TIME ZONE e.timezone)::date + h.\"time\") AT TIME ZONE e.timezone), 'scheduled'::checkin_status FROM elders e JOIN health_routines h ON h.elder_id = e.id AND h.enabled WHERE e.active AND e.consent_confirmed_at IS NOT NULL AND h.start_date <= (now() AT TIME ZONE e.timezone)::date AND (h.end_date IS NULL OR h.end_date >= (now() AT TIME ZONE e.timezone)::date) AND (cardinality(h.days_of_week) = 0 OR (ARRAY['sunday','monday','tuesday','wednesday','thursday','friday','saturday'])[extract(dow from (now() AT TIME ZONE e.timezone)::date)::int + 1] = ANY(h.days_of_week)) AND NOT EXISTS (SELECT 1 FROM checkins c WHERE c.health_routine_id = h.id AND c.scheduled_for = (((now() AT TIME ZONE e.timezone)::date + h.\"time\") AT TIME ZONE e.timezone)) RETURNING 1) SELECT count(*)::int AS materialised FROM ins",
        "resource": "database"
      },
      "position": [
        224,
        96
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
      "credentials": {
        "postgres": {
          "id": "WH9oLDfKfOX6KW5F",
          "name": "ElderWise Supabase (Postgres)"
        }
      },
      "id": "ab864ccb-2911-4b12-aa01-d13febb850d8",
      "name": "Find Due Health Check-ins",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "connectionTimeout": 10
        },
        "query": "SELECT c.id AS checkin_id, e.first_name AS elder_first_name, e.whatsapp_number AS elder_whatsapp, h.name AS routine_name FROM checkins c JOIN elders e ON e.id = c.elder_id JOIN health_routines h ON h.id = c.health_routine_id AND h.enabled WHERE c.status = 'scheduled' AND c.domain = 'health' AND e.active AND e.consent_confirmed_at IS NOT NULL AND c.scheduled_for <= now() AND now() <= c.scheduled_for + make_interval(mins => h.escalation_minutes) ORDER BY c.scheduled_for LIMIT 10",
        "resource": "database"
      },
      "position": [
        448,
        96
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
