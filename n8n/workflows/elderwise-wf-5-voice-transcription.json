      "name": "Resolve Check-in",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "connectionTimeout": 10,
          "queryReplacement": "={{ [ $json.sender_e164, $json.context_wamid || \"\" ] }}"
        },
        "query": "SELECT c.id AS checkin_id, c.elder_id, c.domain::text AS domain, e.first_name AS elder_first_name, e.whatsapp_number AS elder_whatsapp, COALESCE(h.question, CASE c.domain WHEN 'food' THEN 'Have you had your ' || COALESCE(f.meal_name,'meal') || ' today?' ELSE 'Did you take your medicines?' END) AS question, COALESCE((SELECT MAX(v.reask_count) FROM voice_replies v WHERE v.checkin_id = c.id), 0) AS prior_reasks FROM checkins c JOIN elders e ON e.id = c.elder_id LEFT JOIN food_routines f ON f.id = c.food_routine_id LEFT JOIN health_routines h ON h.id = c.health_routine_id WHERE e.whatsapp_number = $1::text AND e.active AND e.consent_confirmed_at IS NOT NULL AND e.consent_declined_at IS NULL AND c.status IN ('sent','reminded') AND ($2::text = '' OR c.wa_message_id = $2::text) ORDER BY c.sent_at DESC LIMIT 1"
