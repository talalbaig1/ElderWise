    {
      "id": "446ddf3a-2b38-495d-985e-4bb909076795",
      "name": "Normalise Gate Answer",
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst ctx = $('Prepare Gate Prompt').first().json;\nconst vr = $('Voice Reply Stored?').first().json;\n\n// The node output shape varies; try every plausible field rather than assume one.\nconst text = String(raw.output?.[0]?.content?.[0]?.text ?? raw.content ?? raw.text ?? raw.message ?? '').toLowerCase().replace(/[^a-z]+/g, ' ').trim();\n// N3 / X10: default to unclear. The model returns a word; code decides.\nlet answer = 'unclear';\nif (text === 'yes' || text.indexOf('yes') === 0) { answer = 'yes'; }\nelse if (text === 'no' || text.indexOf('no') === 0) { answer = 'no'; }\n\nreturn [{ json: { answer: answer, is_clear: answer !== 'unclear', gate_raw: text, voice_reply_id: vr.voice_reply_id, checkin_id: ctx.checkin_id, elder_first_name: ctx.elder_first_name, elder_whatsapp: ctx.elder_whatsapp, question: ctx.question, prior_reasks: ctx.prior_reasks } }];"
