      "id": "77c0c509-8b39-4f96-bc74-eefd21975431",
      "name": "Prepare Gate Prompt",
      "parameters": {
        "jsCode": "const t = $input.first().json;\nconst ctx = $('Resolve Check-in').first().json;\nconst up = $('Upload To Voice Notes Bucket').first().json;\nconst transcript = String(t.text ?? '').trim();\n\nconst prompt = 'You are reading a transcript of an elderly person spoken reply to the question: \"' + String(ctx.question) + '\". Answer with exactly one word - yes, no, or unclear. Use unclear if the transcript is ambiguous, empty, off-topic, or you are not confident. Never guess. Transcript: \"' + transcript + '\"';\n\nreturn [{ json: { prompt: prompt, transcript: transcript, audio_path: String(up.Key ?? ''), checkin_id: ctx.checkin_id, elder_id: ctx.elder_id, elder_first_name: ctx.elder_first_name, elder_whatsapp: ctx.elder_whatsapp, question: ctx.question, prior_reasks: ctx.prior_reasks } }];"
      },
