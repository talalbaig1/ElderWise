      "id": "4d9962b6-a8a5-4d1b-9b26-ffa5b118a13c",
      "name": "Open Or Create SOS Event",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "connectionTimeout": 10,
          "queryReplacement": "={{ $json.elder_id }}"
        },
        "query": "WITH existing AS (SELECT id FROM sos_events WHERE elder_id = $1::uuid AND status = 'open' ORDER BY triggered_at DESC LIMIT 1), inserted AS (INSERT INTO sos_events (elder_id, triggered_at, status, nudges_sent) SELECT $1::uuid, now(), 'open'::sos_status, 0 WHERE NOT EXISTS (SELECT 1 FROM existing) RETURNING id) SELECT COALESCE((SELECT id FROM existing), (SELECT id FROM inserted)) AS sos_event_id, ((SELECT id FROM existing) IS NOT NULL) AS reused"
      },
