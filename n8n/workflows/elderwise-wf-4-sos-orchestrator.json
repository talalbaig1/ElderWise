      "id": "d1a61f51-48e3-4b03-ac0e-67cff4e6793e",
      "name": "Mint Doctor Share Link",
      "onError": "continueRegularOutput",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "connectionTimeout": 10,
          "queryReplacement": "={{ [ $json.elder_id, $('Open Or Create SOS Event').first().json.sos_event_id ] }}"
        },
        "query": "WITH circle AS (SELECT d.id AS dr_id, e.care_partner_id FROM elders e JOIN doctors d ON d.elder_id = e.id WHERE e.id = $1::uuid AND d.whatsapp_number IS NOT NULL), t AS (SELECT encode(extensions.gen_random_bytes(32), 'hex') AS raw FROM circle), ins AS (INSERT INTO doctor_share_links (elder_id, token_hash, created_by, expires_at, sos_event_id) SELECT $1::uuid, encode(extensions.digest(t.raw, 'sha256'), 'hex'), circle.care_partner_id, now() + interval '30 days', $2::uuid FROM t, circle RETURNING id) SELECT (SELECT raw FROM t) AS raw_token, (SELECT id FROM ins) AS share_link_id"
      },
      "position": [
        1344,
        576
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
      "id": "641fc61b-ad16-4059-acbc-d511aabba204",
      "name": "Build Dispatch Parameters",
      "parameters": {
        "jsCode": "const c = $('Load Care Circle').first().json;\n\nlet rawToken = '';\ntry { rawToken = $('Mint Doctor Share Link').first().json.raw_token || ''; } catch (e) { rawToken = ''; }\n\nconst reportLink = rawToken ? 'https://elder-wise-seven.vercel.app/share/' + rawToken : 'NA';\n\nconst buddyFirst = c.lct_first_name || '';\nlet who = \"I've let your family know right away.\";\nif (c.has_lct === true && c.dr_sendable === true) { who = \"I've let your family know, and \" + buddyFirst + \" and your doctor as well.\"; }\nelse if (c.has_lct === true) { who = \"I've let your family know, and \" + buddyFirst + \" as well.\"; }\nelse if (c.dr_sendable === true) { who = \"I've let your family know, and your doctor as well.\"; }\n\nconst ackText = c.elder_first_name + ', ' + who + \" Help is on the way. Stay where you are \\u2014 you're not alone.\";\n\nreturn [{ json: Object.assign({}, c, { report_link: reportLink, share_link_minted: rawToken.length > 0, elder_ack_text: ackText }) }];"
      },
      "position": [
        1568,
        576
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
