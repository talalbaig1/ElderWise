      "id": "1e872578-5e15-4f45-9d7e-f4f3040c9d1d",
      "name": "Attribute And Resolve",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "connectionTimeout": 10,
          "queryReplacement": "={{ $json.context_wamid }}"
        },
        "query": "WITH target AS (SELECT n.sos_event_id, n.recipient_role, n.recipient_id, n.nudge_index FROM sos_notifications n WHERE n.wa_message_id = $1::text AND n.status = 'sent' LIMIT 1) UPDATE sos_events s SET status = 'resolved'::sos_status, resolved_by_role = t.recipient_role::text::sos_resolver_role, resolved_by_id = t.recipient_id, resolved_channel = 'whatsapp'::sos_resolve_channel, resolved_at = now() FROM target t WHERE s.id = t.sos_event_id AND s.status = 'open' RETURNING s.id AS sos_event_id, s.elder_id, s.resolved_by_role::text AS resolved_by_role, s.resolved_by_id, s.resolved_channel::text AS resolved_channel, s.resolved_at, t.nudge_index AS answered_nudge_index",
        "resource": "database"
      },
