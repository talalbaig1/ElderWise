      "id": "89a56d9d-be85-4a24-b60c-bf6f8b0a6f44",
      "name": "Attribute And Record Response",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "connectionTimeout": 10,
          "queryReplacement": "={{ $json.context_wamid }},{{ $json.button_norm }}"
        },
        "query": "WITH target AS (SELECT c.id FROM checkins c WHERE c.wa_message_id = $1::text AND c.domain IN ('food','health') AND c.status IN ('sent','reminded') LIMIT 1) UPDATE checkins c SET status = 'responded'::checkin_status, responded_at = now(), response_value = $2::text, response_channel = 'button'::response_channel FROM target t WHERE c.id = t.id RETURNING c.id AS checkin_id, 'interaction' AS notification_type, c.elder_id, c.domain::text AS domain, c.response_value, c.status::text AS status, c.responded_at",
        "resource": "database"
      },
