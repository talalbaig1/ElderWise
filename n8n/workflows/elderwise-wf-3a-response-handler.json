          "queryReplacement": "={{ $json.sender_e164 }}"
        },
        "query": "SELECT (x.checkin_id IS NOT NULL) AS found, x.checkin_id, x.elder_id, x.status_text, x.scheduled_for FROM (SELECT 1) AS probe LEFT JOIN LATERAL (SELECT c.id AS checkin_id, c.elder_id, c.status::text AS status_text, c.scheduled_for FROM checkins c JOIN elders e ON e.id = c.elder_id WHERE e.whatsapp_number = $1::text AND e.active AND c.domain = 'medication' AND c.status IN ('sent','reminded') ORDER BY c.scheduled_for DESC LIMIT 1) x ON true",
