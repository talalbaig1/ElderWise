      "id": "24606f42-8ee2-4c6d-bced-11d3bab25da7",
      "name": "Record Response",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "connectionTimeout": 10,
          "queryReplacement": "={{ $json.checkin_id }},{{ $('Called By WF-2a').first().json.button_norm }}"
        },
        "query": "WITH mapped AS (SELECT $1::uuid AS cid, CASE $2::text WHEN 'yes all' THEN 'yes_all' WHEN 'some of them' THEN 'some_of_them' WHEN 'not yet' THEN 'not_yet' ELSE 'unknown' END AS rv), upd AS (UPDATE checkins c SET response_channel = 'button', response_value = mapped.rv, responded_at = now(), status = CASE WHEN mapped.rv = 'not_yet' THEN c.status ELSE 'responded'::checkin_status END FROM mapped WHERE c.id = mapped.cid AND c.status IN ('sent','reminded') RETURNING c.id, c.elder_id, c.scheduled_for, c.response_value, c.status::text AS status_text), items AS (INSERT INTO checkin_medication_items (checkin_id, medication_id, taken) SELECT u.id, m.id, true FROM upd u JOIN elders e ON e.id = u.elder_id JOIN medications m ON m.elder_id = e.id AND m.enabled AND m.active AND to_char(u.scheduled_for AT TIME ZONE e.timezone, 'HH24:MI') = ANY(m.times) WHERE u.response_value = 'yes_all' RETURNING 1) SELECT (SELECT id FROM upd) AS checkin_id, (SELECT response_value FROM upd) AS response_value, (SELECT status_text FROM upd) AS status_text, (SELECT count(*)::int FROM items) AS medicines_recorded, 'interaction' AS notification_type",
        "resource": "database"
