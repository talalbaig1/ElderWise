        "postgres": {
          "id": "WH9oLDfKfOX6KW5F",
          "name": "ElderWise Supabase (Postgres)"
        }
      },
      "id": "90821a7f-7ff8-4f40-b6f1-ad25e2c15dec",
      "name": "Mark Reminded",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "connectionTimeout": 10,
          "queryReplacement": "={{ $('Find Due Reminders').item.json.checkin_id }}"
        },
        "query": "UPDATE checkins SET status = 'reminded', reminder_sent_at = now() WHERE id = $1::uuid AND status = 'sent' RETURNING id AS checkin_id, status::text AS status_text, reminder_sent_at",
        "resource": "database"
      },
