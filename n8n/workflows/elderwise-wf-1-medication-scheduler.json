          "name": "ElderWise Supabase (Postgres)"
        }
      },
      "id": "514d845b-55d1-4456-a9ac-f77faa700f8c",
      "name": "Materialise Due Check-ins",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "connectionTimeout": 30
        },
        "query": "WITH ins AS (INSERT INTO checkins (elder_id, domain, scheduled_for, status) SELECT DISTINCT e.id, 'medication'::care_domain, sf.scheduled_for, 'scheduled'::checkin_status FROM elders e JOIN medications m ON m.elder_id = e.id AND m.enabled AND m.active CROSS JOIN LATERAL (SELECT (((now() AT TIME ZONE e.timezone)::date + t::time) AT TIME ZONE e.timezone) AS scheduled_for FROM unnest(m.times) AS t) sf WHERE e.active AND e.consent_confirmed_at IS NOT NULL AND m.start_date <= (now() AT TIME ZONE e.timezone)::date AND (m.end_date IS NULL OR m.end_date >= (now() AT TIME ZONE e.timezone)::date) AND (cardinality(m.days_of_week) = 0 OR (ARRAY['sunday','monday','tuesday','wednesday','thursday','friday','saturday'])[extract(dow from (now() AT TIME ZONE e.timezone)::date)::int + 1] = ANY(m.days_of_week)) AND NOT EXISTS (SELECT 1 FROM checkins c WHERE c.elder_id = e.id AND c.domain = 'medication' AND c.scheduled_for = sf.scheduled_for) RETURNING 1) SELECT count(*)::int AS materialised FROM ins"
      },
      "position": [
        224,
        96
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
      "credentials": {
        "postgres": {
          "id": "WH9oLDfKfOX6KW5F",
          "name": "ElderWise Supabase (Postgres)"
        }
      },
      "id": "68b4470e-a3ef-4d3b-943b-a9976782919e",
      "name": "Find Due Check-ins",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "connectionTimeout": 10
        },
        "query": "SELECT c.id AS checkin_id, e.first_name AS elder_first_name, e.whatsapp_number AS elder_whatsapp, to_char(c.scheduled_for AT TIME ZONE e.timezone, 'FMHH12:MI AM') AS scheduled_label, string_agg(m.name, ', ' ORDER BY m.name) AS medicine_list FROM checkins c JOIN elders e ON e.id = c.elder_id JOIN medications m ON m.elder_id = e.id AND m.enabled AND m.active AND to_char(c.scheduled_for AT TIME ZONE e.timezone, 'HH24:MI') = ANY(m.times) AND (cardinality(m.days_of_week) = 0 OR (ARRAY['sunday','monday','tuesday','wednesday','thursday','friday','saturday'])[extract(dow from (c.scheduled_for AT TIME ZONE e.timezone)::date)::int + 1] = ANY(m.days_of_week)) WHERE c.status = 'scheduled' AND c.domain = 'medication' AND e.active AND e.consent_confirmed_at IS NOT NULL AND c.scheduled_for <= now() GROUP BY c.id, e.first_name, e.whatsapp_number, c.scheduled_for, e.timezone HAVING now() <= c.scheduled_for + make_interval(mins => MIN(m.escalation_minutes)) ORDER BY c.scheduled_for LIMIT 10"
      },
      "position": [
        448,
        96
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
