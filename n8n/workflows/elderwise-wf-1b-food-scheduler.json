      "id": "2553c8e1-8d5f-428d-84f4-7a56fd54ca25",
      "name": "Materialise Due Food Check-ins",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "connectionTimeout": 15
        },
        "query": "WITH ins AS (INSERT INTO checkins (elder_id, domain, food_routine_id, scheduled_for, status) SELECT e.id, 'food'::care_domain, f.id, (((now() AT TIME ZONE e.timezone)::date + f.check_in_time) AT TIME ZONE e.timezone), 'scheduled'::checkin_status FROM elders e JOIN food_routines f ON f.elder_id = e.id AND f.enabled WHERE e.active AND e.consent_confirmed_at IS NOT NULL AND f.start_date <= (now() AT TIME ZONE e.timezone)::date AND (f.end_date IS NULL OR f.end_date >= (now() AT TIME ZONE e.timezone)::date) AND (cardinality(f.days_of_week) = 0 OR (ARRAY['sunday','monday','tuesday','wednesday','thursday','friday','saturday'])[extract(dow from (now() AT TIME ZONE e.timezone)::date)::int + 1] = ANY(f.days_of_week)) AND NOT EXISTS (SELECT 1 FROM checkins c WHERE c.food_routine_id = f.id AND c.scheduled_for = (((now() AT TIME ZONE e.timezone)::date + f.check_in_time) AT TIME ZONE e.timezone)) RETURNING 1) SELECT count(*)::int AS materialised FROM ins"
      },
      "position": [
        224,
        96
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
      "credentials": {
        "postgres": {
          "id": "WH9oLDfKfOX6KW5F",
          "name": "ElderWise Supabase (Postgres)"
        }
      },
      "id": "17e8225a-b306-4fb4-a7c5-e2d1d9d6c0f8",
      "name": "Find Due Food Check-ins",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "connectionTimeout": 15
        },
        "query": "SELECT c.id AS checkin_id, e.first_name AS elder_first_name, e.whatsapp_number AS elder_whatsapp, f.meal_name FROM checkins c JOIN elders e ON e.id = c.elder_id JOIN food_routines f ON f.id = c.food_routine_id AND f.enabled WHERE c.status = 'scheduled' AND c.domain = 'food' AND e.active AND e.consent_confirmed_at IS NOT NULL AND c.scheduled_for <= now() AND now() <= c.scheduled_for + make_interval(mins => f.escalation_minutes) ORDER BY c.scheduled_for LIMIT 10"
      },
      "position": [
        448,
        96
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
