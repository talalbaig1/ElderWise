  "meta": {
    "aiBuilderAssisted": true,
    "builderVariant": "mcp"
  },
  "name": "ElderWise WF-0 - Consent Welcome Dispatch",
  "nodes": [
    {
      "id": "41a444fe-22b0-439e-8b5d-1619625da4a0",
      "name": "Every 5 Minutes",
      "parameters": {
        "rule": {
          "interval": [
            {
