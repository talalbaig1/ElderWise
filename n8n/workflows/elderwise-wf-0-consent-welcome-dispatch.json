    {
      "credentials": {
        "postgres": {
          "id": "WH9oLDfKfOX6KW5F",
          "name": "ElderWise Supabase (Postgres)"
        }
      },
      "id": "fe05f82c-095b-4e3a-9724-d03e4664045a",
      "name": "Claim Elder Awaiting Welcome",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "connectionTimeout": 10
        },
        "query": "UPDATE elders e SET consent_requested_at = now() FROM care_partners cp WHERE cp.id = e.care_partner_id AND e.id = (SELECT e2.id FROM elders e2 WHERE e2.active = true AND e2.consent_attested_by_ct = true AND e2.consent_requested_at IS NULL AND e2.consent_confirmed_at IS NULL AND e2.consent_declined_at IS NULL ORDER BY e2.created_at LIMIT 1 FOR UPDATE SKIP LOCKED) RETURNING e.id AS elder_id, e.first_name AS elder_first_name, e.whatsapp_number AS elder_whatsapp, cp.first_name AS cp_first_name",
        "resource": "database"
      },
      "position": [
        224,
        96
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
      "id": "cb59ea59-9559-41f1-93ba-60517e6a2d57",
      "name": "Anyone To Welcome?",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ !!$json.elder_id }}",
              "operator": {
