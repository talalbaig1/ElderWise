      "name": "Mark Missed And Collect",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "connectionTimeout": 10
        },
        "query": "WITH due AS (SELECT c.id FROM checkins c JOIN elders e ON e.id = c.elder_id LEFT JOIN medications m ON m.elder_id = e.id AND m.enabled AND m.active AND to_char(c.scheduled_for AT TIME ZONE e.timezone, 'HH24:MI') = ANY(m.times) WHERE c.status = 'reminded' AND c.domain = 'medication' AND c.reminder_sent_at IS NOT NULL GROUP BY c.id, c.reminder_sent_at HAVING now() > c.reminder_sent_at + make_interval(mins => COALESCE(MIN(m.escalation_minutes), 30))), upd AS (UPDATE checkins c SET status = 'missed', missed_at = now(), escalated_at = now() FROM due WHERE c.id = due.id RETURNING c.id) SELECT id AS checkin_id, 'missed' AS notification_type FROM upd",
        "resource": "database"
