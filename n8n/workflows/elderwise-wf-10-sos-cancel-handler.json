        },
        "query": "SELECT s.id AS sos_event_id, e.id AS elder_id, e.first_name AS elder_first_name, e.whatsapp_number AS elder_whatsapp FROM sos_events s JOIN elders e ON e.id = s.elder_id WHERE e.whatsapp_number = $1::text AND s.status = 'open' AND e.active AND e.consent_confirmed_at IS NOT NULL AND e.consent_declined_at IS NULL ORDER BY s.triggered_at DESC LIMIT 1",
