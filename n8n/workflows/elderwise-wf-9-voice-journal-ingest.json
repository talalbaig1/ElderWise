    {
      "id": "6f56d948-7fd1-4a84-a4c0-a9f377287a2d",
      "name": "Normalise Classification",
      "parameters": {
        "jsCode": "const raw = $input.first().json;\n\n// Responses API nests the payload at output[0].content[0].text.\n// With json_object format n8n may hand back an object, not a string.\nconst nested = raw.output && raw.output[0] && raw.output[0].content && raw.output[0].content[0]\n  ? raw.output[0].content[0].text\n  : undefined;\n\nconst candidates = [nested, raw.message && raw.message.content, raw.content, raw.text, raw.output];\n\nlet payload = null;\nfor (const c of candidates) {\n  if (payload !== null) { break; }\n  if (c && typeof c === 'object' && !Array.isArray(c)) {\n    payload = c;\n  } else if (typeof c === 'string' && c.length > 0) {\n    const cleaned = c.replace(/```json/g, '').replace(/```/g, '').trim();\n    try {\n      const p = JSON.parse(cleaned);\n      if (p && typeof p === 'object' && !Array.isArray(p)) { payload = p; }\n    } catch (e) { }\n  }\n}\n\nconst MOODS = ['positive','calm','tired','lonely','concerned','neutral'];\nconst URG = ['emergency','attention','none'];\n\nconst moodOk = payload !== null && MOODS.indexOf(payload.mood) !== -1;\nconst urgOk = payload !== null && URG.indexOf(payload.urgency) !== -1;\n\nconst mood = moodOk ? payload.mood : 'neutral';\nconst urgency = urgOk ? payload.urgency : 'none';\nconst summary = payload && typeof payload.summary === 'string' ? payload.summary.slice(0, 300) : '';\n\nconst themes = [];\nif (payload && Array.isArray(payload.themes)) {\n  for (const th of payload.themes) {\n    if (typeof th === 'string' && th.length > 0 && themes.length < 4) {\n      themes.push(th.toLowerCase().slice(0, 40));\n    }\n  }\n}\n\n// A classification we could not read is not a quiet 'none' - flag it for a human.\nconst classifyOk = moodOk && urgOk;\nconst attentionFlag = urgency !== 'none' || !classifyOk;\n\nreturn [{ json: { mood: mood, urgency: urgency, summary: summary, themes_csv: String(themes), attention_flag: attentionFlag, classify_ok: classifyOk, raw_text: JSON.stringify(raw).slice(0, 500) } }];"
      },
