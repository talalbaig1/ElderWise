    {
      "credentials": {
        "postgres": {
          "id": "WH9oLDfKfOX6KW5F",
          "name": "ElderWise Supabase (Postgres)"
        }
      },
      "id": "0f1ab52d-1962-40f5-b554-e3594bdd0285",
      "name": "Find Due Nudge Recipients",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "connectionTimeout": 30
        },
        "query": "WITH due AS (SELECT s.id, s.elder_id, s.triggered_at, s.nudges_sent + 1 AS next_nudge_index FROM sos_events s WHERE s.status = 'open' AND s.nudges_sent < 3 AND now() > (SELECT MAX(n.sent_at) FROM sos_notifications n WHERE n.sos_event_id = s.id AND n.status = 'sent') + interval '2 minutes' ORDER BY s.triggered_at LIMIT 1), recips AS (SELECT DISTINCT n.recipient_role, n.recipient_id FROM sos_notifications n JOIN due ON n.sos_event_id = due.id WHERE n.status = 'sent') SELECT due.id AS sos_event_id, due.next_nudge_index, e.first_name AS elder_first_name, r.recipient_role::text AS recipient_role, r.recipient_id, CASE r.recipient_role WHEN 'care_partner' THEN cp.whatsapp_number WHEN 'local_caregiver' THEN lc.whatsapp_number WHEN 'doctor' THEN d.whatsapp_number END AS recipient_number, to_char(due.triggered_at AT TIME ZONE (CASE r.recipient_role WHEN 'care_partner' THEN cp.timezone ELSE e.timezone END), 'FMHH12:MI AM') AS triggered_label FROM recips r CROSS JOIN due JOIN elders e ON e.id = due.elder_id LEFT JOIN care_partners cp ON cp.id = r.recipient_id AND r.recipient_role = 'care_partner' LEFT JOIN local_caregivers lc ON lc.id = r.recipient_id AND r.recipient_role = 'local_caregiver' LEFT JOIN doctors d ON d.id = r.recipient_id AND r.recipient_role = 'doctor'"
      },
      "position": [
        224,
        96
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
      "id": "41824204-94c5-44bd-b6ad-e927ceb800ff",
