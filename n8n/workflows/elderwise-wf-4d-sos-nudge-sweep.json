  "description": "WF-4d SOS nudge sweep, cron 1 min. Guarded: a CTE SELECT returning zero rows emits success:true, not an empty set, so an explicit gate sits before the send.",
  "id": "EY36qDhdv5FqfL0W",
  "meta": {
    "aiBuilderAssisted": true,
    "builderVariant": "mcp"
  },
  "name": "ElderWise WF-4d - SOS Nudge Sweep",
  "nodes": [
    {
      "id": "92e92c56-1c6e-4294-b327-0578d20ec7af",
      "name": "Every Minute",
      "parameters": {
        "rule": {
          "interval": [
