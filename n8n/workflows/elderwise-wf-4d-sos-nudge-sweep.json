      "id": "e9cc1438-a79a-4469-a419-1b5ed0e99ef6",
      "name": "Log Nudge Notification",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "connectionTimeout": 10,
          "queryReplacement": "={{ $('Any Nudge Due?').item.json.sos_event_id }},{{ $('Any Nudge Due?').item.json.recipient_role }},{{ $('Any Nudge Due?').item.json.recipient_id }},{{ $('Any Nudge Due?').item.json.next_nudge_index }},{{ $json.messages[0].id }}"
        },
        "query": "INSERT INTO sos_notifications (sos_event_id, recipient_role, recipient_id, nudge_index, status, wa_message_id, sent_at) VALUES ($1::uuid, $2::sos_recipient_role, $3::uuid, $4::int, 'sent'::sos_notification_status, $5::text, now()) RETURNING id, nudge_index, recipient_role::text AS role"
